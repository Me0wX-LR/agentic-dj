{
  "id": "agentic-dj",
  "title": "Agentic DJ",
  "description": "A GM-side multi-agent soundtrack director for Foundry VTT v14. It analyzes playlist audio locally, listens to scene/combat/chat plus an optional GM microphone, then suggests 2–3 fitting tracks for the GM to confirm before playback.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "AgentKevin2077",
      "url": "https://github.com/Me0wX-LR"
    }
  ],
  "esmodules": [
    "src/main.js"
  ],
  "styles": [
    "styles/agentic-dj.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": false,
  "url": "https://github.com/Me0wX-LR/agentic-dj",
  "manifest": "https://raw.githubusercontent.com/Me0wX-LR/agentic-dj/main/module.json",
  "download": "https://github.com/Me0wX-LR/agentic-dj/archive/refs/heads/main.zip",
  "bugs": "https://github.com/Me0wX-LR/agentic-dj/issues",
  "readme": "https://github.com/Me0wX-LR/agentic-dj#readme",
  "license": "LICENSE",
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang"]
    }
  }
}
