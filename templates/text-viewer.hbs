<div class="standard-form flexcol agentic-dj-settings agentic-dj-viewer">
  <p class="notes">{{hint}}</p>
  <p class="agentic-dj-meta">{{path}}</p>
  <pre class="agentic-dj-viewer-body">{{text}}</pre>
  <footer class="form-footer">
    <button type="button" data-action="copy"><i class="fa-solid fa-copy"></i> {{localize "AGENTICDJ.Viewer.Copy"}}</button>
    <button type="button" data-action="download"><i class="fa-solid fa-download"></i> {{localize "AGENTICDJ.Viewer.Download"}}</button>
  </footer>
</div>
