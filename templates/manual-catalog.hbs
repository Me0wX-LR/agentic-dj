<div class="standard-form flexcol agentic-dj-settings">
  <p class="notes">{{localize "AGENTICDJ.Manual.Hint"}}</p>
  <p class="agentic-dj-progress">{{progress}}</p>

  <div class="form-group">
    <label>{{localize "AGENTICDJ.Manual.List"}}</label>
    <textarea name="catalogText" rows="16" spellcheck="false">{{catalogText}}</textarea>
  </div>

  <div class="form-group">
    <label>{{localize "AGENTICDJ.Manual.Situation"}}</label>
    <input type="text" name="situationNote" value="{{situationNote}}" placeholder="{{localize 'AGENTICDJ.Manual.SituationPlaceholder'}}" />
    <p class="hint">{{localize "AGENTICDJ.Manual.SituationHint"}}</p>
  </div>

  <footer class="form-footer">
    <button type="button" data-action="fill"><i class="fa-solid fa-list"></i> {{localize "AGENTICDJ.Manual.Fill"}}</button>
    <button type="button" data-action="apply"><i class="fa-solid fa-tags"></i> {{localize "AGENTICDJ.Manual.Apply"}}</button>
    <button type="button" data-action="applySuggest"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "AGENTICDJ.Manual.ApplySuggest"}}</button>
  </footer>
</div>
