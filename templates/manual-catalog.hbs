<div class="agentic-dj-manual">
  <div class="standard-form flexcol agentic-dj-settings">
    <p class="notes">{{l.hint}}</p>
    <p class="agentic-dj-progress">{{progress}}</p>

    <fieldset class="agentic-dj-fieldset">
      <legend>{{l.jsonFile}}</legend>
      <div class="form-group">
        <label>{{l.jsonFile}}</label>
        <input type="file" name="importJson" accept="application/json,.json" />
      </div>
      <div class="form-group">
        <label>{{l.jsonPaste}}</label>
        <textarea name="jsonPaste" rows="6" placeholder="{{l.jsonPastePlaceholder}}">{{jsonPaste}}</textarea>
      </div>
      <p class="flexrow agentic-dj-json-actions">
        <button type="button" data-action="applyJson">
          <i class="fa-solid fa-file-import"></i>
          <span>{{l.applyJson}}</span>
        </button>
        <button type="button" data-action="exportJson">
          <i class="fa-solid fa-file-export"></i>
          <span>{{l.exportJson}}</span>
        </button>
      </p>
    </fieldset>

    <div class="form-group">
      <label>{{l.situation}}</label>
      <input type="text" name="situationNote" value="{{situationNote}}" placeholder="{{l.situationPlaceholder}}" />
      <p class="hint">{{l.situationHint}}</p>
    </div>

    <div class="agentic-dj-table-wrap">
      <table class="agentic-dj-table">
        <thead>
          <tr>
            <th>{{localize "AGENTICDJ.Manual.Include"}}</th>
            <th>{{localize "AGENTICDJ.Manual.Track"}}</th>
            <th>{{localize "AGENTICDJ.Manual.Mood"}}</th>
            <th>{{localize "AGENTICDJ.Manual.Intensity"}}</th>
            <th>{{localize "AGENTICDJ.Manual.Tags"}}</th>
            <th>{{localize "AGENTICDJ.Manual.UseWhen"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows as |row|}}
          <tr data-sound-id="{{row.soundId}}" data-name="{{row.name}}">
            <td><input type="checkbox" name="include" {{#if row.included}}checked{{/if}} /></td>
            <td>
              <button type="button" class="agentic-dj-row-play" data-action="playRow" data-sound-id="{{row.soundId}}" title="{{../l.play}}">
                <i class="fa-solid fa-play"></i>
              </button>
              <strong>{{row.name}}</strong>
              <div class="agentic-dj-meta">{{row.playlistName}}</div>
            </td>
            <td>
              <select name="mood">
                {{#each row.moodOptions as |opt|}}
                <option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                {{/each}}
              </select>
            </td>
            <td><input type="number" name="intensity" min="1" max="5" value="{{row.intensityValue}}" /></td>
            <td><input type="text" name="tags" value="{{row.tags}}" /></td>
            <td><input type="text" name="useWhen" value="{{row.useWhen}}" /></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{#unless rows.length}}
      <p>{{localize "AGENTICDJ.NoTracks"}}</p>
    {{/unless}}
    <p class="flexrow agentic-dj-json-actions">
      <button type="button" data-action="playIncluded">
        <i class="fa-solid fa-play"></i>
        <span>{{l.play}}</span>
      </button>
      <button type="button" data-action="pausePlayback">
        <i class="fa-solid fa-pause"></i>
        <span>{{l.pause}}</span>
      </button>
      <button type="button" data-action="shuffleIncluded">
        <i class="fa-solid fa-shuffle"></i>
        <span>{{l.shuffle}}</span>
      </button>
    </p>
  </div>

  <footer class="form-footer agentic-dj-manual-footer">
    <button type="button" data-action="fillEmpty" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-file"></i>
      <span>{{l.fillEmpty}}</span>
    </button>
    <button type="button" data-action="fillAnalyzed" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-tags"></i>
      <span>{{l.fillAnalyzed}}</span>
    </button>
    <button type="button" data-action="applyTags" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-floppy-disk"></i>
      <span>{{l.save}}</span>
    </button>
    <button type="button" data-action="saveLlm" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      <span>{{l.saveLlm}}</span>
    </button>
    <button type="button" data-action="saveSuggest" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-forward"></i>
      <span>{{l.saveSuggest}}</span>
    </button>
  </footer>
</div>
