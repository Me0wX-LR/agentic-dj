<form class="flexcol">
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmProvider"}}</label>
    <select name="llmProvider">
      {{#each llmProviders}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmBaseUrl"}}</label>
    <input type="text" name="llmBaseUrl" value="{{llmBaseUrl}}" placeholder="https://openrouter.ai/api/v1" />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmModel"}}</label>
    <input type="text" name="llmModel" value="{{llmModel}}" />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmApiKey"}}</label>
    <input type="password" name="llmApiKey" value="{{llmApiKey}}" autocomplete="off" />
  </div>

  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.SttProvider"}}</label>
    <select name="sttProvider">
      {{#each sttProviders}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.SttBaseUrl"}}</label>
    <input type="text" name="sttBaseUrl" value="{{sttBaseUrl}}" />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.SttModel"}}</label>
    <input type="text" name="sttModel" value="{{sttModel}}" />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.SttApiKey"}}</label>
    <input type="password" name="sttApiKey" value="{{sttApiKey}}" autocomplete="off" />
  </div>

  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.ExtraInstructions"}}</label>
    <textarea name="extraInstructions" rows="3">{{extraInstructions}}</textarea>
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.AutoAnalyze"}}</label>
    <input type="checkbox" name="autoAnalyze" {{#if autoAnalyze}}checked{{/if}} />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.Cooldown"}}</label>
    <input type="number" name="cooldown" value="{{cooldown}}" min="5" max="120" />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.MaxProposals"}}</label>
    <input type="number" name="maxProposals" value="{{maxProposals}}" min="1" max="3" />
  </div>
  <footer class="form-footer">
    <button type="submit"><i class="fa-solid fa-save"></i> {{localize "AGENTICDJ.Settings.Save"}}</button>
  </footer>
</form>
