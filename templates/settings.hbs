<div class="standard-form flexcol agentic-dj-settings">
  <p class="notes">{{localize "AGENTICDJ.SettingsMenuHint"}}</p>

  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmProvider"}}</label>
    <select name="llmProvider">
      {{#each llmProviders}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmBaseUrl"}}</label>
    <input type="text" name="llmBaseUrl" value="{{llmBaseUrl}}" placeholder="https://openrouter.ai/api/v1" />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmModel"}}</label>
    <input type="text" name="llmModel" value="{{llmModel}}" />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmApiKey"}}</label>
    <input type="password" name="llmApiKey" value="" autocomplete="off" spellcheck="false" placeholder="{{llmKeyPlaceholder}}" />
    {{#if hasLlmKey}}
      <p class="hint">{{localize "AGENTICDJ.Settings.KeySaved"}} {{llmKeyHint}}</p>
    {{else}}
      <p class="hint">{{localize "AGENTICDJ.Settings.KeyMissing"}}</p>
    {{/if}}
  </div>

  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.SttProvider"}}</label>
    <select name="sttProvider">
      {{#each sttProviders}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.SttBaseUrl"}}</label>
    <input type="text" name="sttBaseUrl" value="{{sttBaseUrl}}" />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.SttModel"}}</label>
    <input type="text" name="sttModel" value="{{sttModel}}" />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.SttApiKey"}}</label>
    <input type="password" name="sttApiKey" value="" autocomplete="off" spellcheck="false" placeholder="{{sttKeyPlaceholder}}" />
    {{#if hasSttKey}}
      <p class="hint">{{localize "AGENTICDJ.Settings.KeySaved"}} {{sttKeyHint}}</p>
    {{/if}}
  </div>

  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmTemperature"}}</label>
    <input type="number" name="llmTemperature" value="{{llmTemperature}}" min="0" max="2" step="0.1" />
    <p class="hint">{{localize "AGENTICDJ.Settings.LlmTemperatureHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmMaxTokens"}}</label>
    <input type="number" name="llmMaxTokens" value="{{llmMaxTokens}}" min="64" max="4000" step="1" />
    <p class="hint">{{localize "AGENTICDJ.Settings.LlmMaxTokensHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.LlmTopP"}}</label>
    <input type="number" name="llmTopP" value="{{llmTopP}}" min="0" max="1" step="0.05" />
    <p class="hint">{{localize "AGENTICDJ.Settings.LlmTopPHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.ExtraInstructions"}}</label>
    <textarea name="extraInstructions" rows="3">{{extraInstructions}}</textarea>
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.AutoAnalyze"}}</label>
    <input type="checkbox" name="autoAnalyze" {{#if autoAnalyze}}checked{{/if}} />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.Cooldown"}}</label>
    <input type="number" name="cooldown" value="{{cooldown}}" min="5" max="120" />
  </div>
  <div class="form-group">
    <label>{{localize "AGENTICDJ.Settings.MaxProposals"}}</label>
    <input type="number" name="maxProposals" value="{{maxProposals}}" min="1" max="3" />
  </div>
  <footer class="form-footer flexrow">
    <button type="button" data-action="save"><i class="fa-solid fa-save"></i> {{localize "AGENTICDJ.Settings.Save"}}</button>
    <button type="button" data-action="clearKeys"><i class="fa-solid fa-eraser"></i> {{localize "AGENTICDJ.Settings.ClearKeys"}}</button>
  </footer>
</div>
